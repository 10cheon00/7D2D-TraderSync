<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TraderSync</AssemblyName>
    <RootNamespace>TraderSync</RootNamespace>
    <Version>2.1.1</Version>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <GamePath Condition="'$(GamePath)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\7 Days To Die</GamePath>
    <GameManagedPath>$(GamePath)\7DaysToDie_Data\Managed</GameManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <None Update="ModInfo.xml" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)\Mods\0_TFP_Harmony\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LogLibrary">
      <HintPath>$(GameManagedPath)\LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManagedPath)\Assembly-CSharp.dll')"
           Text="Game assembly not found. Set GamePath to the 7 Days To Die installation directory." />
    <Error Condition="!Exists('$(GamePath)\Mods\0_TFP_Harmony\0Harmony.dll')"
           Text="Harmony not found under GamePath\Mods\0_TFP_Harmony." />
  </Target>
</Project>
